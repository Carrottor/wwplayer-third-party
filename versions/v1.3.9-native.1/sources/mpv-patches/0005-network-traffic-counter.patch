+static void account_network_bytes(stream_t *s)
+{
+    AVIOContext *avio = s->priv;
+    if (!s->is_network || !avio)
+        return;
+    int64_t received = 0;
+    uint64_t total = av_opt_get_int(avio, "wwplayer_downloaded_bytes",
+        AV_OPT_SEARCH_CHILDREN, &received) >= 0 ? received : avio->bytes_read;
+    if (total > s->network_read_accounted) {
+        atomic_fetch_add_explicit(&s->global->network_bytes,
+            total - s->network_read_accounted, memory_order_relaxed);
+        s->network_read_accounted = total;
+    }
+}
