-    if (!src->no_clip || !init)
-        demux_seek(new->d, start_pts, flags);
+    if (!src->no_clip || !init) {
+        double seek_pts = start_pts;
+        if (!src->no_clip && new->seek_preroll > 0) {
+            // Timestamp seeking (e.g. MPEG-TS) need not land on a RAP.
+            // Decode the preceding source window even on automatic switches.
+            // Packet start/end still delimit the authored presentation range.
+            // A leading RAP DTS can precede presentation start (B frames).
+            // Source seek owns beginning-of-file selection; presentation
+            // start is not a lower bound for the decode window.
+            seek_pts -= new->seek_preroll;
+            flags = (flags & ~SEEK_FORWARD) | SEEK_HR;
