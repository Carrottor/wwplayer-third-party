+// Measure the rendered glyph/border parts, not guessed line counts.
+static void stack_subtitles(struct osd_state *osd, struct sub_bitmap_list *list,
+                            struct mp_osd_res res)
+{
+    m_config_cache_update(osd->subtitle_opts_cache);
+    struct sub_bitmaps *blocks[2] = {0};
+    int top[2] = {INT_MAX, INT_MAX}, bottom[2] = {0}, offset[2] = {0};
+    for (int n = 0; n < list->num_items; n++) {
+        struct sub_bitmaps *b = list->items[n];
+        if (b->render_index != OSDTYPE_SUB && b->render_index != OSDTYPE_SUB2) continue;
+        int i = b->render_index - OSDTYPE_SUB;
+        blocks[i] = b;
+        for (int k = 0; k < b->num_parts; k++) {
+            top[i] = MPMIN(top[i], b->parts[k].y);
+            bottom[i] = MPMAX(bottom[i], b->parts[k].y + b->parts[k].dh);
+        }
+    }
+    // ASS default keeps all authored positions. An explicit height change
+    // translates the whole block without stripping tags or altering glyphs.
+    for (int i = 0; i < 2; i++) {
+        if (blocks[i] && !sub_is_plaintext(osd->objs[i]->sub) &&
+            !osd->subtitle_opts->ass_style_override[i] && osd->subtitle_opts->sub_pos[i] != 100) {
+            int height = bottom[i] - top[i];
+            offset[i] = lrint((res.h - height) * osd->subtitle_opts->sub_pos[i] / 100.0) - top[i];
+        }
+    }
+    // Placement operates on rendered blocks, including ASS and bitmap parts.
+    // It never strips authored tags or changes the primary track's style.
+    if (osd->subtitle_opts->secondary_sub_follow && blocks[1]) {
+        int gap = lrint(osd->subtitle_opts->secondary_sub_gap * res.h / 720.0);
+        int margin = lrint(24.0 * res.h / 720.0);
+        int lower = res.h - margin;
+        int height = bottom[1] - top[1];
+        int primary_top = blocks[0] ? top[0] + offset[0] : lower;
+        int primary_bottom = blocks[0] ? bottom[0] + offset[0] :
+            MPCLAMP(lrint(res.h * osd->subtitle_opts->sub_pos[0] / 100.0), margin, lower);
+        switch (osd->subtitle_opts->secondary_sub_placement) {
+        case 0: // Top. Only move primary if it occupies the same space.
+            offset[1] = margin - top[1];
+            if (blocks[0] && primary_top < margin + height + gap)
+                offset[0] += margin + height + gap - primary_top;
+            break;
+        case 2: // Above primary, preserving the primary bottom anchor.
+            offset[1] = primary_top - gap - bottom[1];
+            break;
+        case 3: // Bottom. Reserve a disjoint block for a bottom primary.
+            offset[1] = lower - bottom[1];
+            if (blocks[0] && primary_bottom > lower - height - gap)
+                offset[0] += lower - height - gap - primary_bottom;
+            break;
+        default: // Below primary; both grow upwards from the primary anchor.
+            offset[1] = primary_bottom - bottom[1];
+            if (blocks[0]) offset[0] -= height + gap;
+            break;
+        }
+        // Keep fitting groups within the viewport without guessing line counts
+        // or silently changing the selected font size.
+        int group_top = top[1] + offset[1], group_bottom = bottom[1] + offset[1];
+        if (blocks[0]) {
+            group_top = MPMIN(group_top, top[0] + offset[0]);
+            group_bottom = MPMAX(group_bottom, bottom[0] + offset[0]);
+        }
+        if (group_bottom - group_top <= lower - margin) {
+            int shift = group_top < margin ? margin - group_top :
+                group_bottom > lower ? lower - group_bottom : 0;
+            offset[1] += shift;
+            if (blocks[0]) offset[0] += shift;
+        }
+    }
+    for (int i = 0; i < 2; i++) {
+        struct osd_object *obj = osd->objs[i];
+        if (obj->subtitle_stack_offset != offset[i]) {
+            obj->subtitle_stack_offset = offset[i]; obj->vo_change_id++; list->change_id++;
+        }
+        if (!blocks[i]) continue;
+        blocks[i]->change_id = obj->vo_change_id;
+        for (int k = 0; k < blocks[i]->num_parts; k++) blocks[i]->parts[k].y += offset[i];
+    }
+}
